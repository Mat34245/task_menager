<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Tło  -->
    <item>
        <shape>
            <solid android:color="#BDE8F5"/>

            <stroke
                android:width="2dp"
                android:color="#000000"/>

            <corners android:radius="10dp"/>
        </shape>
    </item>

    <!-- Nine Sols  -->
    <item
        android:gravity="top|end"
        android:right="10dp"
        android:top="10dp">

        <shape android:shape="oval">
            <size
                android:width="50dp"
                android:height="50dp"/>
            <solid android:color="#1C4D8D"/>
        </shape>

    </item>

</layer-list>