<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivityFunctionAdd"
    android:background="#BDE8F5"
    android:padding="24dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Edytuj Zadanie"
        android:textAlignment="center"
        android:textColor="#0F2854"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_gravity="center"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:backgroundTint="@color/white"
        android:padding="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_marginBottom="20dp"
                android:hint="Edytuj nazwe aktywności"
                android:textColor="#0F2854"
                android:backgroundTint="#1C4D8D"
                android:padding="12dp"
                android:textSize="20sp"
                android:textColorHint="#4988C4"
                android:layout_height="wrap_content"/>



            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edytuj Ikonę"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textSize="21sp"
                android:textColor="#1C4D8D"
                android:layout_marginBottom="8dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Spinner
                    android:id="@+id/icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/spinner_background"
                    android:padding="5dp"/>

                <ImageView
                    android:id="@+id/arrow"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginRight="12dp"
                    android:src="@drawable/arrow"
                    android:clickable="false"
                    android:focusable="false"/>

            </RelativeLayout>

            <DatePicker
                android:id="@+id/date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minDate=""
                android:datePickerMode="spinner"
                android:calendarViewShown="false"/>
            <Button
                android:id="@+id/btn2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zatwierdź"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/white"
                android:backgroundTint="#0F2854"
                android:layout_marginTop="10dp"
                android:padding="14dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>