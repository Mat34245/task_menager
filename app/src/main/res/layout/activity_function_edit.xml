<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ActivityFunctionAdd"
    android:background="#BDE8F5"
    android:padding="24dp"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Edytuj Zadanie"
        android:layout_marginLeft="87dp"
        android:textAlignment="center"
        android:textColor="#0F2854"
        android:textSize="28sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:backgroundTint="@color/white"
        android:padding="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_marginBottom="20dp"
                android:hint="Edytuj nazwe aktywności"
                android:textColor="#0F2854"
                android:backgroundTint="#1C4D8D"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColorHint="#4988C4"
                android:layout_height="wrap_content"/>



            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Zmień ikonę"
                android:layout_marginBottom="20dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                app:boxStrokeColor="#4988C4"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <AutoCompleteTextView
                    android:id="@+id/iconAutoComplete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#0F2854"/>

            </com.google.android.material.textfield.TextInputLayout>
            //KURWA MAC CZEMO TO TU NADAL JEST I NIKT TEGO NIE ZUPDATOWAŁ TO MI ZAJEŁO CHWILE ZEBY OGARNĄC CZEMO TO NIE DZIAŁĄ
            <EditText
                android:id="@+id/date"
                android:layout_width="match_parent"
                android:layout_marginBottom="20dp"
                android:hint="Edytuj date"
                android:textColor="#0F2854"
                android:backgroundTint="#1C4D8D"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColorHint="#4988C4"
                android:layout_height="wrap_content"/>
            <Button
                android:id="@+id/btn2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zatwierdź"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:textColor="@color/white"
                android:backgroundTint="#0F2854"
                android:layout_marginTop="10dp"
                android:padding="14dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</LinearLayout>