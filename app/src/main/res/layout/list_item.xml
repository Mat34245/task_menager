<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listItem"
    android:background="@drawable/border_list"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12px"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingLeft="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dateView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="date"
                android:textStyle="italic"
                android:textColor="#0F2854"
                android:textSize="20sp"/>

        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/idView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="10"
                android:layout_marginRight="9.5sp"
                android:paddingBottom="5dp"
                android:paddingLeft="2dp"
                android:textColor="@color/white"
                android:textSize="23sp"
                android:gravity="center_vertical|center"/>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!--Jak nie bedzie ładne to usunąc android:background="@drawable/icon",    android:clipToOutline="true"-->
        <ImageView
            android:background="@drawable/icon"
            android:id="@+id/iconView"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/desktop"
            android:layout_marginLeft="5dp"
            android:clipToOutline="true"/>

        <TextView
            android:id="@+id/nameView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name"
            android:layout_marginLeft="10dp"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#0F2854"
            android:fontFamily="sans-serif-medium"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="5dp">

        <Button
            android:text="Usuń"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40sp"
            android:textColor="@color/white"
            android:backgroundTint="#1C4D8D"
            android:layout_marginStart="2dp"
            android:id="@+id/deleteButton"
            android:textStyle="bold"/>
        <Button
            android:text="Edytuj"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40sp"
            android:backgroundTint="#1f6acc"
            android:textColor="@color/white"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:id="@+id/editButton"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30sp"
        android:background="@drawable/checkbox_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_marginBottom="7dp">

        <CheckBox
            android:id="@+id/checkbox"
            android:layout_width="wrap_content"
            android:layout_height="30sp"
            android:text="Zrobione"
            android:textSize="17dp"
            android:textStyle="bold|italic"
            android:textColor="@color/white"/>

    </LinearLayout>

</LinearLayout>