<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    android:orientation="vertical"
    android:background="#BDE8F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="15sp">

            <EditText
                android:id="@+id/searchInput"
                android:hint="Wyszukaj nazwe zadania"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10px"
                android:layout_marginLeft="10px"
                android:layout_marginRight="10px"
                android:background="@drawable/search"
                android:padding="10dp"
                android:elevation="6px"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:text="Wyszukaj"
                android:id="@+id/searchButton"
                android:textSize="19dp"
                android:layout_width="0sp"
                android:layout_weight="2"
                android:layout_margin="5dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:backgroundTint="#1f6acc"/>

            <Button
                android:id="@+id/addButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dodaj"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginTop="5dp"
                android:textSize="19dp"
                android:textColor="@color/white"
                android:backgroundTint="#0F2854"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nieukończone"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/white"
            android:background="@drawable/thebigblu"
            android:padding="12dp"
            android:gravity="center"
            android:layout_margin="5sp"/>

        <!--Indian tutorial carrying me rn on how to make it accualy scroll-->
        <ListView
            android:id="@+id/tasksList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@drawable/thebigblu"
            android:dividerHeight="3dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Skończone"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/white"
            android:background="@drawable/thebigblu"
            android:padding="12dp"
            android:gravity="center"
            android:layout_margin="5sp"/>

        <ListView
            android:id="@+id/finishedTasksList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@drawable/thebigblu"
            android:dividerHeight="3dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"/>

</LinearLayout>